{
  "packages": [
    "https://github.com/gotgenes/pi-anthropic-auth@v2.0.6"
  ],
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "deepseek-v4-flash",
    "deepseek-v4-pro",
    "claude-sonnet-4-6",
    "claude-opus-4-6",
    "claude-opus-4-7",
    "claude-opus-4-8",
    "gpt-5.6-terra",
    "gpt-5.6-sol",
    "gpt-5.6-luna"
  ],
  "quietStartup": true,
  "theme": "dark",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "warnings": {
    "anthropicExtraUsage": true
  }
}
